//LEDGBLD  JOB (NUAGE),'USAGE LEDGER BLD',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1),REGION=4096K
//*
//* BUILD THE ONLINE (KICKS) OF THE USAGE LEDGER
//* SUBMITTED BY NUAGE-CLUSTER (MVS-CONFIG) WHEN THIS JOB CHANGES.
//* TO BUILD BY HAND: S RUNJOB,M=LEDGBLD,L='NUAGE.USAGE.JCLLIB'
//*
//*  SIT/PCT/PPT/FCT : ASSEMBLE THE KICKS TABLES (SUFFIX LG) INTO
//*                NUAGE.USAGE.KICKS.V1R5M0.SKIKLOAD
//*  LBALSET/LLSTSET : KIKMAPS MAKES THE PHYSICAL MAP (KIKRPL) AND THE
//*                SYMBOLIC MAP (COBCOPY) OF EACH MAP SET
//*  LBALPGM/LLSTPGM : K2KCOBCL PREPROCESSES EXEC KICKS, COMPILES
//*                (COBOL-68) AND LINKS INTO NUAGE.USAGE.KICKS.V1R5M0.
//*                KIKRPL
//*
//* THE PROCS COME FROM KICKS (JOBPROC). KIKSUSR NAMES THE LIBRARIES
//* OF THIS APPLICATION: NUAGE.USAGE.KICKS.V1R5M0.*, AS KICKS DOES FOR
//* A USER (CLIST KICKS, TSOID(NUAGE.USAGE)).
//*
//JOBPROC  DD DSN=KICKS.KICKSSYS.V1R5M0.PROCLIB,DISP=SHR
//*
//* ---------------------------------------------------------- TABLES
//*
//SIT      EXEC PGM=IFOX00,PARM='DECK,NOLIST'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DUMMY
//SYSPUNCH DD DSN=&&SIT,UNIT=SYSDA,SPACE=(80,(200,200)),DISP=(,PASS)
//SYSIN    DD *
{{KIKSITLG}}
/*
//SITL     EXEC PGM=IEWL,PARM='XREF,MAP,LET,NCAL',COND=(0,NE)
//SYSLIN   DD DSN=&&SIT,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=NUAGE.USAGE.KICKS.V1R5M0.SKIKLOAD(KIKSITLG),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//*
//PCT      EXEC PGM=IFOX00,PARM='DECK,NOLIST',COND=(0,NE)
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DUMMY
//SYSPUNCH DD DSN=&&PCT,UNIT=SYSDA,SPACE=(80,(200,200)),DISP=(,PASS)
//SYSIN    DD *
{{KIKPCTLG}}
/*
//PCTL     EXEC PGM=IEWL,PARM='XREF,MAP,LET,NCAL',COND=(0,NE)
//SYSLIN   DD DSN=&&PCT,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=NUAGE.USAGE.KICKS.V1R5M0.SKIKLOAD(KIKPCTLG),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//*
//PPT      EXEC PGM=IFOX00,PARM='DECK,NOLIST',COND=(0,NE)
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DUMMY
//SYSPUNCH DD DSN=&&PPT,UNIT=SYSDA,SPACE=(80,(200,200)),DISP=(,PASS)
//SYSIN    DD *
{{KIKPPTLG}}
/*
//PPTL     EXEC PGM=IEWL,PARM='XREF,MAP,LET,NCAL',COND=(0,NE)
//SYSLIN   DD DSN=&&PPT,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=NUAGE.USAGE.KICKS.V1R5M0.SKIKLOAD(KIKPPTLG),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//*
//FCT      EXEC PGM=IFOX00,PARM='DECK,NOLIST',COND=(0,NE)
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//         DD DSN=KICKS.KICKSSYS.V1R5M0.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//SYSLIN   DD DUMMY
//SYSPUNCH DD DSN=&&FCT,UNIT=SYSDA,SPACE=(80,(200,200)),DISP=(,PASS)
//SYSIN    DD *
{{KIKFCTLG}}
/*
//FCTL     EXEC PGM=IEWL,PARM='XREF,MAP,LET,NCAL',COND=(0,NE)
//SYSLIN   DD DSN=&&FCT,DISP=(OLD,DELETE)
//SYSLMOD  DD DSN=NUAGE.USAGE.KICKS.V1R5M0.SKIKLOAD(KIKFCTLG),DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(2,1))
//SYSPRINT DD SYSOUT=*
//*
//* ---------------------------------------------------------- MAPS
//*
//LBALSET  EXEC KIKMAPS,MAPNAME=LBALSET,KIKSUSR='NUAGE.USAGE.KICKS'
//COPY.SYSUT1 DD *
{{LBALSET}}
/*
//LLSTSET  EXEC KIKMAPS,MAPNAME=LLSTSET,KIKSUSR='NUAGE.USAGE.KICKS'
//COPY.SYSUT1 DD *
{{LLSTSET}}
/*
//*
//* ---------------------------------------------------------- PROGRAMS
//*
//* THE COBOL COMPILER OF MVS/CE IS IN SYSC.LINKLIB, NOT IN THE LINK
//* LIST, SO THE TWO COMPILE STEPS OF K2KCOBCL GET A STEPLIB.
//*
//LBALPGM  EXEC K2KCOBCL,KIKSUSR='NUAGE.USAGE.KICKS'
//COPY.SYSUT1 DD *
{{LBALPGM}}
/*
//COB1.STEPLIB DD DSN=SYSC.LINKLIB,DISP=SHR
//COB2.STEPLIB DD DSN=SYSC.LINKLIB,DISP=SHR
//LKED.SYSIN DD *
 INCLUDE SKIKLOAD(KIKCOBGL)
 ENTRY LBALPGM
 NAME LBALPGM(R)
/*
//LLSTPGM  EXEC K2KCOBCL,KIKSUSR='NUAGE.USAGE.KICKS'
//COPY.SYSUT1 DD *
{{LLSTPGM}}
/*
//COB1.STEPLIB DD DSN=SYSC.LINKLIB,DISP=SHR
//COB2.STEPLIB DD DSN=SYSC.LINKLIB,DISP=SHR
//LKED.SYSIN DD *
 INCLUDE SKIKLOAD(KIKCOBGL)
 ENTRY LLSTPGM
 NAME LLSTPGM(R)
/*
//
