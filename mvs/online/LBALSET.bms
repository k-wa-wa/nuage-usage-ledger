***********************************************************************
* LBALSET - ACCOUNT INQUIRY (TRANSACTION LBAL, PROGRAM LBALPGM)
* ONE ACCOUNT OF THE INQUIRY MASTER AND ITS JOURNAL, 10 LINES A
* PAGE. THE SYMBOLIC MAP (COPY LBALSET) IS MADE BY THE BUILD JOB.
***********************************************************************
         PRINT NOGEN
LBALSET  DFHMSD TYPE=&SYSPARM,LANG=COBOL,MODE=INOUT,CTRL=FREEKB,       X
               STORAGE=AUTO,TIOAPFX=YES
LBALMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
***********************************************************************
* TITLE
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=BLUE,      X
               INITIAL='LBAL'
         DFHMDF POS=(1,10),LENGTH=35,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL, X
               INITIAL='NUAGE USAGE LEDGER  ACCOUNT INQUIRY'
         DFHMDF POS=(1,55),LENGTH=13,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='AS OF CLOSING'
ASOF     DFHMDF POS=(1,69),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
***********************************************************************
* ACCOUNT NUMBER AND THE MONTH TO START THE JOURNAL FROM (INPUT)
         DFHMDF POS=(3,2),LENGTH=11,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='ACCOUNT NO.'
         DFHMDF POS=(3,14),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='===>'
ACCT     DFHMDF POS=(3,19),LENGTH=11,ATTRB=(UNPROT,NORM,IC,FSET),      X
               COLOR=TURQUOISE
         DFHMDF POS=(3,31),LENGTH=1,ATTRB=(PROT,NORM)
         DFHMDF POS=(3,36),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='FROM MONTH'
         DFHMDF POS=(3,48),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='===>'
MONTH    DFHMDF POS=(3,53),LENGTH=6,ATTRB=(UNPROT,NORM,FSET),          X
               COLOR=TURQUOISE
         DFHMDF POS=(3,60),LENGTH=1,ATTRB=(PROT,NORM)
         DFHMDF POS=(3,62),LENGTH=17,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='YYYYMM (OPTIONAL)'
         DFHMDF POS=(4,19),LENGTH=34,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='100-NNNNNNN K8S / 200-NNNNNNN HOST'
***********************************************************************
* ACCOUNT MASTER
         DFHMDF POS=(5,2),LENGTH=5,ATTRB=(ASKIP,NORM),COLOR=GREEN,     X
               INITIAL='CLASS'
CLASS    DFHMDF POS=(5,16),LENGTH=5,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(5,24),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='NAME'
NAME     DFHMDF POS=(5,30),LENGTH=24,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(6,2),LENGTH=7,ATTRB=(ASKIP,NORM),COLOR=GREEN,     X
               INITIAL='BALANCE'
BAL      DFHMDF POS=(6,16),LENGTH=15,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(6,32),LENGTH=2,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='RU'
OVER     DFHMDF POS=(6,36),LENGTH=20,ATTRB=(ASKIP,BRT),COLOR=RED
         DFHMDF POS=(7,2),LENGTH=9,ATTRB=(ASKIP,NORM),COLOR=GREEN,     X
               INITIAL='ALLOCATED'
ALLOC    DFHMDF POS=(7,16),LENGTH=15,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(7,32),LENGTH=2,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='RU'
         DFHMDF POS=(7,40),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='USED'
USED     DFHMDF POS=(7,48),LENGTH=15,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(7,64),LENGTH=2,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='RU'
         DFHMDF POS=(8,2),LENGTH=6,ATTRB=(ASKIP,NORM),COLOR=GREEN,     X
               INITIAL='OPENED'
OPENED   DFHMDF POS=(8,16),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(8,30),LENGTH=11,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='LAST POSTED'
LASTP    DFHMDF POS=(8,43),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(8,56),LENGTH=6,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='STATUS'
STAT     DFHMDF POS=(8,64),LENGTH=15,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
***********************************************************************
* JOURNAL OF THE ACCOUNT, NEWEST FIRST, 10 LINES A PAGE
         DFHMDF POS=(10,2),LENGTH=37,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL, X
               INITIAL='JOURNAL OF THE ACCOUNT (NEWEST FIRST)'
         DFHMDF POS=(10,70),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='PAGE'
PAGE     DFHMDF POS=(10,75),LENGTH=3,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
         DFHMDF POS=(11,2),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='DATE'
         DFHMDF POS=(11,14),LENGTH=3,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='SEQ'
         DFHMDF POS=(11,21),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='TYPE'
         DFHMDF POS=(11,35),LENGTH=5,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='DR/CR'
         DFHMDF POS=(11,50),LENGTH=11,ATTRB=(ASKIP,NORM),COLOR=GREEN,  X
               INITIAL='AMOUNT (RU)'
         DFHMDF POS=(11,67),LENGTH=12,ATTRB=(ASKIP,NORM),COLOR=GREEN,  X
               INITIAL='BALANCE (RU)'
JL01     DFHMDF POS=(12,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL02     DFHMDF POS=(13,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL03     DFHMDF POS=(14,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL04     DFHMDF POS=(15,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL05     DFHMDF POS=(16,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL06     DFHMDF POS=(17,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL07     DFHMDF POS=(18,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL08     DFHMDF POS=(19,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL09     DFHMDF POS=(20,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
JL10     DFHMDF POS=(21,2),LENGTH=77,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
***********************************************************************
* MESSAGE AND KEYS
MSG      DFHMDF POS=(23,2),LENGTH=77,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,2),LENGTH=31,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='ENTER=INQUIRE  PF5=ACCOUNT LIST'
         DFHMDF POS=(24,35),LENGTH=30,ATTRB=(ASKIP,NORM),COLOR=BLUE,   X
               INITIAL='PF7=BACK  PF8=FORWARD  PF3=END'
         DFHMSD TYPE=FINAL
         END
