PROC 0
/* LEDGER - THE ONLINE (KICKS) OF THE USAGE LEDGER                  */
/*   EXEC 'NUAGE.USAGE.CLIST(LEDGER)'                               */
/* TRANSACTIONS: LLST (ACCOUNT LIST), LBAL (ACCOUNT INQUIRY),       */
/*               KSSF (SIGN OFF, BACK TO TSO)                       */
/*                                                                  */
/* ALLOCATES THE INQUIRY FILES (MADE BY THE JOB LEDGINQ AFTER EVERY */
/* CLOSING), THEN KICKS'S OWN CLIST STARTS KICKS WITH:              */
/*   TSOID(NUAGE.USAGE) THE LIBRARIES NUAGE.USAGE.KICKS.V1R5M0.*    */
/*                      (TABLES IN SKIKLOAD, PROGRAMS IN KIKRPL)    */
/*   SIT(LG)            THE TABLES OF THIS APPLICATION (KIKSITLG    */
/*                      NAMES KIKPCTLG, KIKPPTLG AND KIKFCTLG), AND */
/*                      THE ACCOUNT LIST (LLST) AS THE FIRST SCREEN */
CONTROL NOMSG
FREE FI(INQMAST INQJRNL)
CONTROL MSG
ALLOC FI(INQMAST) DA('NUAGE.USAGE.INQMAST') SHR
ALLOC FI(INQJRNL) DA('NUAGE.USAGE.INQJRNL') SHR
EXEC 'KICKS.KICKSSYS.V1R5M0.CLIST(KICKS)' +
  'TSOID(NUAGE.USAGE) SIT(LG)'
CONTROL NOMSG
FREE FI(INQMAST INQJRNL)
