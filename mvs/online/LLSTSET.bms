***********************************************************************
* LLSTSET - ACCOUNT LIST (TRANSACTION LLST, PROGRAM LLSTPGM)
* THE ACCOUNTS OF THE INQUIRY MASTER IN ACCOUNT ORDER, 15 A PAGE.
* THE SYMBOLIC MAP (COPY LLSTSET) IS MADE BY THE BUILD JOB.
***********************************************************************
         PRINT NOGEN
LLSTSET  DFHMSD TYPE=&SYSPARM,LANG=COBOL,MODE=INOUT,CTRL=FREEKB,       X
               STORAGE=AUTO,TIOAPFX=YES
LLSTMAP  DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
***********************************************************************
* TITLE
         DFHMDF POS=(1,2),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=BLUE,      X
               INITIAL='LLST'
         DFHMDF POS=(1,10),LENGTH=32,ATTRB=(ASKIP,NORM),COLOR=NEUTRAL, X
               INITIAL='NUAGE USAGE LEDGER  ACCOUNT LIST'
         DFHMDF POS=(1,55),LENGTH=13,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='AS OF CLOSING'
ASOF     DFHMDF POS=(1,69),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
***********************************************************************
* START ACCOUNT NUMBER (INPUT)
         DFHMDF POS=(3,2),LENGTH=20,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='START AT ACCOUNT NO.'
         DFHMDF POS=(3,23),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='===>'
ACCT     DFHMDF POS=(3,28),LENGTH=11,ATTRB=(UNPROT,NORM,IC,FSET),      X
               COLOR=TURQUOISE
         DFHMDF POS=(3,40),LENGTH=1,ATTRB=(PROT,NORM)
         DFHMDF POS=(4,2),LENGTH=38,ATTRB=(ASKIP,NORM),COLOR=BLUE,     X
               INITIAL='TYPE S BEFORE AN ACCOUNT TO INQUIRE IT'
***********************************************************************
* ACCOUNTS, 15 A PAGE. OVERDRAWN ONES ARE BRIGHT
         DFHMDF POS=(5,2),LENGTH=1,ATTRB=(ASKIP,NORM),COLOR=GREEN,     X
               INITIAL='S'
         DFHMDF POS=(5,4),LENGTH=10,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='ACCOUNT NO'
         DFHMDF POS=(5,17),LENGTH=5,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='CLASS'
         DFHMDF POS=(5,24),LENGTH=4,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='NAME'
         DFHMDF POS=(5,53),LENGTH=12,ATTRB=(ASKIP,NORM),COLOR=GREEN,   X
               INITIAL='BALANCE (RU)'
         DFHMDF POS=(5,67),LENGTH=2,ATTRB=(ASKIP,NORM),COLOR=GREEN,    X
               INITIAL='ST'
SEL01    DFHMDF POS=(6,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN01     DFHMDF POS=(6,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL02    DFHMDF POS=(7,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN02     DFHMDF POS=(7,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL03    DFHMDF POS=(8,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN03     DFHMDF POS=(8,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL04    DFHMDF POS=(9,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN04     DFHMDF POS=(9,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL05    DFHMDF POS=(10,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN05     DFHMDF POS=(10,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL06    DFHMDF POS=(11,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN06     DFHMDF POS=(11,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL07    DFHMDF POS=(12,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN07     DFHMDF POS=(12,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL08    DFHMDF POS=(13,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN08     DFHMDF POS=(13,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL09    DFHMDF POS=(14,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN09     DFHMDF POS=(14,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL10    DFHMDF POS=(15,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN10     DFHMDF POS=(15,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL11    DFHMDF POS=(16,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN11     DFHMDF POS=(16,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL12    DFHMDF POS=(17,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN12     DFHMDF POS=(17,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL13    DFHMDF POS=(18,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN13     DFHMDF POS=(18,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL14    DFHMDF POS=(19,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN14     DFHMDF POS=(19,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
SEL15    DFHMDF POS=(20,2),LENGTH=1,ATTRB=(UNPROT,NORM),COLOR=TURQUOISE
LN15     DFHMDF POS=(20,4),LENGTH=76,ATTRB=(ASKIP,NORM),COLOR=TURQUOISE
***********************************************************************
* MESSAGE AND KEYS
MSG      DFHMDF POS=(23,2),LENGTH=77,ATTRB=(ASKIP,BRT),COLOR=YELLOW
         DFHMDF POS=(24,2),LENGTH=18,ATTRB=(ASKIP,NORM),COLOR=BLUE,    X
               INITIAL='ENTER=SELECT/START'
         DFHMDF POS=(24,22),LENGTH=30,ATTRB=(ASKIP,NORM),COLOR=BLUE,   X
               INITIAL='PF7=BACK  PF8=FORWARD  PF3=END'
         DFHMSD TYPE=FINAL
         END
