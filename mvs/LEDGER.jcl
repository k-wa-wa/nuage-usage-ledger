//LEDGER   JOB (NUAGE),'USAGE LEDGER',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//*
//* DAILY CLOSING OF THE USAGE LEDGER
//* SUBMITTED EVERY MORNING BY ZTIMER (SEE SCHEDULE):
//*   S RUNJOB,M=LEDGER,L='NUAGE.USAGE.JCLLIB'
//*
//*  GET     : REXX FETCHES THE USAGE FROM THE NEXT BUSINESS DATE
//*            (NUAGE.USAGE.BIZDATE) TO YESTERDAY. RC 4 = UP TO DATE
//*  TRANGEN : COBOL CONVERTS THE USAGE TO RU AND MAKES TRANSACTIONS
//*            (USAGE, AND THE WEEKLY ALLOCATION ON MONDAYS)
//*  SORT    : BY ACCOUNT, DATE AND TYPE
//*  POSTING : COBOL POSTS THE TRANSACTIONS TO THE LEDGER AND CHECKS
//*            THE TRIAL BALANCE. RC 16 = A CHECK FAILED
//*  COMMIT  : ONLY IF ALL STEPS ENDED WITH RC 0, THE NEW GENERATIONS
//*            AND THE NEXT BUSINESS DATE ARE WRITTEN
//*
//* ON THE FIRST RUN (BIZDATE EMPTY) THE LEDGER STARTS FROM YESTERDAY,
//* OR FROM P='MODE=LEDGER START=YYYY-MM-DD' ON THE GET STEP.
//*
//GET      EXEC RXBATCH,SLIB='SYS2.EXEC',EXEC=DUMMY,
//             P='MODE=LEDGER'
//EXEC.RXRUN DD DATA,DLM=@@
{{USAGEGET}}
@@
//EXEC.USAGE DD DSN=&&RAW,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(10,10)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//EXEC.CTLCARD DD DSN=&&CTL,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(1,1)),DCB=(RECFM=F,LRECL=80,BLKSIZE=80)
//EXEC.BIZDATE DD DSN=NUAGE.USAGE.BIZDATE,DISP=SHR
//*
//TRANGEN  EXEC COBUCG,COND=(0,NE),REGION.GO=1024K
//COB.SYSIN DD *
{{TRANGEN}}
/*
//GO.SYSOUT DD SYSOUT=*
//GO.CTLCARD DD DSN=&&CTL,DISP=(OLD,PASS)
//GO.RATES DD DSN=NUAGE.USAGE.CNTL(RATES),DISP=SHR
//GO.ACCTDEF DD DSN=NUAGE.USAGE.CNTL(ACCTDEF),DISP=SHR
//GO.USAGE DD DSN=&&RAW,DISP=(OLD,DELETE)
//GO.TRANS DD DSN=&&TRAN,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(10,10)),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=1000)
//GO.REPORT DD SYSOUT=M,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=133)
//*
//* SORT WORK FILES GO TO THE 2314 SORT PACKS (SORTW1-6). THE SORT
//* OF THIS ERA CANNOT USE 3380/3390 FOR WORK FILES (IER042A).
//*
//SORT     EXEC SORT,COND=(0,NE)
//SORT.SORTIN DD DSN=&&TRAN,DISP=(OLD,DELETE)
//SORT.SORTOUT DD DSN=&&STRAN,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(10,10)),
//             DCB=(RECFM=FB,LRECL=100,BLKSIZE=1000)
//SORT.SORTWK01 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK02 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK03 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SYSIN DD *
  SORT FIELDS=(1,10,CH,A,11,8,CH,A,19,1,CH,A)
/*
//*
//POSTING  EXEC COBUCG,COND=(0,NE),REGION.GO=1024K
//COB.SYSIN DD *
{{POSTING}}
/*
//GO.SYSOUT DD SYSOUT=*
//GO.CTLCARD DD DSN=&&CTL,DISP=(OLD,DELETE)
//GO.ACCTDEF DD DSN=NUAGE.USAGE.CNTL(ACCTDEF),DISP=SHR
//GO.OLDMAST DD DSN=NUAGE.USAGE.MASTER(0),DISP=SHR
//GO.TRANS DD DSN=&&STRAN,DISP=(OLD,DELETE)
//GO.OLDGL DD DSN=NUAGE.USAGE.GL(0),DISP=SHR
//GO.NEWMAST DD DSN=&&NMAST,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=100,BLKSIZE=1000)
//GO.JOURNAL DD DSN=&&NJRN,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(10,10)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//GO.NEWGL DD DSN=&&NGL,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//GO.NEWBIZ DD DSN=&&NBIZ,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(1,1)),DCB=(RECFM=F,LRECL=80,BLKSIZE=80)
//GO.REPORT DD SYSOUT=M,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=133)
//*
//* COMMIT: THE NEW GENERATIONS AND THE NEXT BUSINESS DATE. GDG
//* GENERATIONS NEED A MODEL (PATTERN DSCB) IN MVS 3.8J, GIVEN BY
//* DCB=(NUAGE.USAGE.GDGMODEL,...).
//*
//CMASTER  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&NMAST,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=NUAGE.USAGE.MASTER(+1),DISP=(NEW,CATLG),
//             UNIT=3380,VOL=SER=PUB000,SPACE=(TRK,(5,5)),
//             DCB=(NUAGE.USAGE.GDGMODEL,
//             RECFM=FB,LRECL=100,BLKSIZE=1000)
//CJOURNAL EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&NJRN,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=NUAGE.USAGE.JOURNAL(+1),DISP=(NEW,CATLG),
//             UNIT=3380,VOL=SER=PUB000,SPACE=(TRK,(10,10)),
//             DCB=(NUAGE.USAGE.GDGMODEL,
//             RECFM=FB,LRECL=80,BLKSIZE=800)
//CGL      EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&NGL,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=NUAGE.USAGE.GL(+1),DISP=(NEW,CATLG),
//             UNIT=3380,VOL=SER=PUB000,SPACE=(TRK,(1,1)),
//             DCB=(NUAGE.USAGE.GDGMODEL,
//             RECFM=FB,LRECL=80,BLKSIZE=800)
//CBIZDATE EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&NBIZ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=NUAGE.USAGE.BIZDATE,DISP=OLD
//
