//LEDGMON  JOB (NUAGE),'USAGE LEDGER MONTH',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//*
//* MONTHLY CLOSING OF THE USAGE LEDGER
//* SUBMITTED BY LEDGER AFTER EVERY DAILY CLOSING. TO RUN BY HAND:
//*   S RUNJOB,M=LEDGMON,L='NUAGE.USAGE.JCLLIB'
//*
//*  MONSEL  : COBOL FINDS THE MONTH TO CLOSE (ALL ITS DAYS CLOSED)
//*            AND SELECTS ITS JOURNAL. RC 4 = NO MONTH TO CLOSE
//*  SORT    : BY ACCOUNT, DATE AND SEQ
//*  ACCTLDG : COBOL PRINTS THE ACCOUNT LEDGER OF THE MONTH AND CHECKS
//*            IT AGAINST THE MASTER AND THE GL. RC 16 = A CHECK FAILED
//*  COMMIT  : ONLY IF ALL STEPS ENDED WITH RC 0, THE SAVED JOURNAL,
//*            THE MONTH-END BALANCES AND THE LAST CLOSED MONTH ARE
//*            WRITTEN
//*  ONLINE  : ALWAYS, THE JOB LEDGINQ IS SUBMITTED. IT COPIES THE
//*            LEDGER INTO THE INQUIRY FILES OF THE ONLINE (KICKS)
//*
//* THE DAILY GENERATIONS OF THE JOURNAL ARE KEPT FOR 35 CLOSINGS.
//* THE SAVED JOURNAL (ONE GENERATION A MONTH) IS KEPT FOR 255 MONTHS.
//*
//MONSEL   EXEC COBUCG,REGION.GO=1024K
//COB.SYSIN DD *
{{MONSEL}}
/*
//GO.SYSOUT DD SYSOUT=*
//GO.BIZDATE DD DSN=NUAGE.USAGE.BIZDATE,DISP=SHR
//GO.JOURNAL DD DSN=NUAGE.USAGE.JOURNAL,DISP=SHR
//GO.LASTHIST DD DSN=NUAGE.USAGE.JRNLHIST(0),DISP=SHR
//GO.EXTRACT DD DSN=&&EXT,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(10,10)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//GO.MONCTL DD DSN=&&MCTL,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(1,1)),DCB=(RECFM=F,LRECL=80,BLKSIZE=80)
//*
//SORT     EXEC SORT,COND=(0,NE)
//SORT.SORTIN DD DSN=&&EXT,DISP=(OLD,DELETE)
//SORT.SORTOUT DD DSN=&&SEXT,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(10,10)),
//             DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SORT.SORTWK01 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK02 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK03 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SYSIN DD *
  SORT FIELDS=(23,10,CH,A,1,8,CH,A,9,6,CH,A)
/*
//*
//ACCTLDG  EXEC COBUCG,COND=(0,NE),REGION.GO=1024K
//COB.SYSIN DD *
{{ACCTLDG}}
/*
//GO.SYSOUT DD SYSOUT=*
//GO.MONCTL DD DSN=&&MCTL,DISP=(OLD,DELETE)
//GO.OLDBAL DD DSN=NUAGE.USAGE.MONBAL(0),DISP=SHR
//GO.MASTER DD DSN=NUAGE.USAGE.MASTER(0),DISP=SHR
//GO.GL    DD DSN=NUAGE.USAGE.GL(0),DISP=SHR
//GO.JOURNAL DD DSN=&&SEXT,DISP=(OLD,DELETE)
//GO.BIZDATE DD DSN=NUAGE.USAGE.BIZDATE,DISP=SHR
//GO.HIST  DD DSN=&&HIST,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//GO.NEWBAL DD DSN=&&NBAL,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(1,1)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//GO.NEWBIZ DD DSN=&&NBIZ,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(1,1)),DCB=(RECFM=F,LRECL=80,BLKSIZE=80)
//GO.REPORT DD SYSOUT=M,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=133)
//*
//* COMMIT: THE NEW GENERATIONS AND THE LAST CLOSED MONTH. THE
//* BUSINESS DATES ARE WRITTEN LAST. IF A COMMIT STEP FAILS HALF WAY,
//* MONSEL STOPS THE NEXT RUN (THE MONTH IS IN JRNLHIST(0) ALREADY).
//*
//CHIST    EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&HIST,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=NUAGE.USAGE.JRNLHIST(+1),DISP=(NEW,CATLG),
//             UNIT=3380,VOL=SER=PUB000,SPACE=(TRK,(5,5)),
//             DCB=(NUAGE.USAGE.GDGMODEL,
//             RECFM=FB,LRECL=80,BLKSIZE=800)
//CMONBAL  EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&NBAL,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=NUAGE.USAGE.MONBAL(+1),DISP=(NEW,CATLG),
//             UNIT=3380,VOL=SER=PUB000,SPACE=(TRK,(1,1)),
//             DCB=(NUAGE.USAGE.GDGMODEL,
//             RECFM=FB,LRECL=80,BLKSIZE=800)
//CBIZDATE EXEC PGM=IEBGENER,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=&&NBIZ,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=NUAGE.USAGE.BIZDATE,DISP=OLD
//*
//* HAND OVER TO THE ONLINE: SUBMIT LEDGINQ THROUGH THE INTERNAL
//* READER, WHETHER A MONTH WAS CLOSED OR NOT (THE DAILY CLOSING
//* BEFORE THIS JOB CHANGED THE LEDGER IN ANY CASE).
//*
//ONLINE   EXEC PGM=IEBGENER,COND=EVEN
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=NUAGE.USAGE.JCLLIB(LEDGINQ),DISP=SHR
//SYSUT2   DD SYSOUT=(A,INTRDR)
//
