//LEDGINQ  JOB (NUAGE),'USAGE LEDGER INQ',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//*
//* INQUIRY FILES FOR THE ONLINE (KICKS)
//* SUBMITTED BY LEDGMON AFTER THE CLOSING. TO REBUILD BY HAND:
//*   S RUNJOB,M=LEDGINQ,L='NUAGE.USAGE.JCLLIB'
//*
//* THE ONLINE ONLY READS THESE COPIES OF THE LEDGER. IT NEVER UPDATES
//* THE LEDGER, SO THE BATCH AND THE ONLINE NEVER UPDATE THE SAME DATA.
//*
//*  INQBLD : COBOL COPIES THE MASTER (0) WITH A CONTROL RECORD, AND
//*           KEYS THE SAVED JOURNAL AND THE JOURNAL (ALL GENERATIONS
//*           OF BOTH) BY ACCOUNT, NEWEST FIRST. THE JOURNAL OF THE
//*           MONTHS ALREADY SAVED IS SKIPPED
//*  SORT   : THE JOURNAL BY THE KEY
//*  LOAD   : DEFINES THE KSDS AGAIN AND LOADS THEM. FAILS IF A KICKS
//*           USER HAS THE FILES: SIGN OFF (KSSF) AND RUN IT AGAIN
//*
//INQBLD   EXEC COBUCG,REGION.GO=1024K
//COB.SYSIN DD *
{{INQBLD}}
/*
//GO.SYSOUT DD SYSOUT=*
//GO.BIZDATE DD DSN=NUAGE.USAGE.BIZDATE,DISP=SHR
//GO.MASTER DD DSN=NUAGE.USAGE.MASTER(0),DISP=SHR
//GO.JRNLHIST DD DSN=NUAGE.USAGE.JRNLHIST,DISP=SHR
//GO.JOURNAL DD DSN=NUAGE.USAGE.JOURNAL,DISP=SHR
//GO.IMAST DD DSN=&&IMAST,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=100,BLKSIZE=1000)
//GO.IJRN  DD DSN=&&IJRN,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(30,30)),
//             DCB=(RECFM=FB,LRECL=104,BLKSIZE=1040)
//*
//SORT     EXEC SORT,COND=(0,NE)
//SORT.SORTIN DD DSN=&&IJRN,DISP=(OLD,DELETE)
//SORT.SORTOUT DD DSN=&&SJRN,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(30,30)),
//             DCB=(RECFM=FB,LRECL=104,BLKSIZE=1040)
//SORT.SORTWK01 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK02 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK03 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SYSIN DD *
  SORT FIELDS=(1,24,CH,A)
/*
//*
//* KSDS IN THE USER CATALOG UCPUB000 (ALIAS NUAGE), DELETED AND
//* DEFINED AGAIN ON EVERY RUN. MVS 3.8 VSAM HAS NO SUBALLOCATION
//* SPACE ON PUB000, SO THE CLUSTERS ARE UNIQUE (NOT REUSE).
//* IF A DELETE FAILS (FILE IN USE), NOTHING AFTER IT IS DONE.
//*
//LOAD     EXEC PGM=IDCAMS,COND=(0,NE)
//SYSPRINT DD SYSOUT=*
//IMAST    DD DSN=&&IMAST,DISP=(OLD,DELETE)
//SJRN     DD DSN=&&SJRN,DISP=(OLD,DELETE)
//SYSIN    DD *
  LISTCAT ENTRIES(NUAGE.USAGE.INQMAST) NAME
  IF LASTCC = 0 THEN DELETE NUAGE.USAGE.INQMAST CLUSTER
  ELSE SET MAXCC = 0
  LISTCAT ENTRIES(NUAGE.USAGE.INQJRNL) NAME
  IF LASTCC = 0 THEN DELETE NUAGE.USAGE.INQJRNL CLUSTER
  ELSE IF MAXCC = 4 THEN SET MAXCC = 0
  IF MAXCC = 0 THEN DO
    DEFINE CLUSTER (NAME(NUAGE.USAGE.INQMAST) INDEXED UNIQUE -
           VOLUMES(PUB000) TRACKS(5 5) SHAREOPTIONS(2 3) -
           RECORDSIZE(100 100) KEYS(10 0)) -
      DATA (NAME(NUAGE.USAGE.INQMAST.DATA)) -
      INDEX (NAME(NUAGE.USAGE.INQMAST.INDEX))
    DEFINE CLUSTER (NAME(NUAGE.USAGE.INQJRNL) INDEXED UNIQUE -
           VOLUMES(PUB000) TRACKS(30 15) SHAREOPTIONS(2 3) -
           RECORDSIZE(104 104) KEYS(24 0)) -
      DATA (NAME(NUAGE.USAGE.INQJRNL.DATA)) -
      INDEX (NAME(NUAGE.USAGE.INQJRNL.INDEX))
  END
  IF MAXCC = 0 THEN DO
    REPRO INFILE(IMAST) OUTDATASET(NUAGE.USAGE.INQMAST)
    REPRO INFILE(SJRN) OUTDATASET(NUAGE.USAGE.INQJRNL)
  END
/*
//
