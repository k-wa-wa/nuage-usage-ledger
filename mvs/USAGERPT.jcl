//USAGERPT JOB (NUAGE),'USAGE REPORT',CLASS=A,MSGCLASS=A,
//             MSGLEVEL=(1,1)
//*
//* DAILY CLUSTER USAGE REPORT
//* SUBMITTED EVERY MORNING BY ZTIMER (SEE SCHEDULE):
//*   S RUNJOB,M=USAGERPT,L='NUAGE.USAGE.JCLLIB'
//*
//*  GET    : REXX FETCHES THE USAGE OF YESTERDAY FROM VICTORIAMETRICS
//*  SORT   : SORT THE RECORDS BY CLASS AND NAME
//*  REPORT : COBOL PRINTS THE REPORT TO SYSOUT CLASS M (PRINTER 2)
//*
//* TO RERUN FOR A DATE, SET P='DATE=2026-10-20' ON THE GET STEP
//*
//GET      EXEC RXBATCH,SLIB='SYS2.EXEC',EXEC=DUMMY,
//             P=''
//EXEC.RXRUN DD DATA,DLM=@@
{{USAGEGET}}
@@
//EXEC.USAGE DD DSN=&&RAW,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//EXEC.CTLCARD DD DSN=&&CTL,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(1,1)),DCB=(RECFM=F,LRECL=80,BLKSIZE=80)
//*
//* SORT WORK FILES GO TO THE 2314 SORT PACKS (SORTW1-6). THE SORT
//* OF THIS ERA CANNOT USE 3380/3390 FOR WORK FILES (IER042A).
//*
//SORT     EXEC SORT,COND=(0,NE)
//SORT.SORTIN DD DSN=&&RAW,DISP=(OLD,DELETE)
//SORT.SORTOUT DD DSN=&&SORTED,DISP=(NEW,PASS),UNIT=3350,
//             SPACE=(TRK,(5,5)),DCB=(RECFM=FB,LRECL=80,BLKSIZE=800)
//SORT.SORTWK01 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK02 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SORTWK03 DD UNIT=2314,SPACE=(CYL,(1,1))
//SORT.SYSIN DD *
  SORT FIELDS=(1,5,CH,A,6,24,CH,A)
/*
//REPORT   EXEC COBUCG,COND=(0,NE)
//COB.SYSIN DD *
{{USAGERPT}}
/*
//GO.SYSOUT DD SYSOUT=*
//GO.CTLCARD DD DSN=&&CTL,DISP=(OLD,DELETE)
//GO.USAGE DD DSN=&&SORTED,DISP=(OLD,DELETE)
//GO.REPORT DD SYSOUT=M,DCB=(RECFM=FBA,LRECL=133,BLKSIZE=133)
//
